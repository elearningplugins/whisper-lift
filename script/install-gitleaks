#!/bin/sh
# Downloads gitleaks 8.30.1 for Linux x64 into the directory given as $1 and refuses to install it unless its SHA-256 matches the published checksum.
set -eu
dest="${1:?usage: script/install-gitleaks <directory>}"
version=8.30.1
sha256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
archive="$dest/gitleaks.tar.gz"
curl -sSfL -o "$archive" "https://github.com/gitleaks/gitleaks/releases/download/v$version/gitleaks_${version}_linux_x64.tar.gz"
echo "$sha256  $archive" | sha256sum -c -
tar -xzf "$archive" -C "$dest" gitleaks
rm "$archive"
